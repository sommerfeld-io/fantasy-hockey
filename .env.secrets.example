# Copy this file to .env.secrets and fill in real values.
# .env.secrets is git-ignored - never commit it, and never commit real
# participant emails or secret values anywhere else in this repo.
#
# docker-compose.yml loads .env.secrets via `env_file:` for both the
# fantasy-hockey and postgres services.

# PostgreSQL connection string. The resolution logic (env var or
# --database-url flag, flag wins) is identical for the raw binary and the
# container, but the host in the value below is not: "postgres" is the
# docker-compose service name, reachable only from inside the compose
# network. Running the compiled binary directly on the host instead, use
# "localhost" (with the port published by docker-compose.yml) or point at
# whatever database that invocation should use.
DATABASE_URL=postgres://fantasy_hockey:change-me@postgres:5432/fantasy_hockey?sslmode=disable

# HMAC signing key for session cookies. The process fails to start if unset.
SESSION_SECRET=change-me-to-a-long-random-string

# Gmail SMTP credentials (smtp.gmail.com:587, STARTTLS). SMTP_APP_PASSWORD is
# a Gmail App Password, not the account's own password - the account needs
# 2-Step Verification enabled to generate one.
SMTP_USERNAME=change-me@gmail.com
SMTP_APP_PASSWORD=change-me-app-password

# The 3 fixed Participants. Real name/email pairs only - never committed
# anywhere else, including here: the placeholders below are deliberately
# generic, not the real participants' names.
PARTICIPANT_1_NAME=change-me
PARTICIPANT_1_EMAIL=change-me@example.com
PARTICIPANT_2_NAME=change-me
PARTICIPANT_2_EMAIL=change-me@example.com
PARTICIPANT_3_NAME=change-me
PARTICIPANT_3_EMAIL=change-me@example.com

# Credentials for the postgres service itself (used by postgres:18-alpine to
# initialize the database, and should match the credentials embedded in
# DATABASE_URL above).
POSTGRES_DB=fantasy_hockey
POSTGRES_USER=fantasy_hockey
POSTGRES_PASSWORD=change-me
